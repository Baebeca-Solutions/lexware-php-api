# baebeca-project-template v1.1.1
# Code style of every project, read by IntelliJ and PhpStorm. A project overrides it for a directory
# with an .editorconfig of its own there, e.g. for bundled third party code.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = false
max_line_length = 120
ij_formatter_tags_enabled = true

[*.{yml,yaml}]
indent_size = 2

[*.php]
ij_php_class_brace_style = end_of_line
ij_php_method_brace_style = end_of_line
ij_php_else_on_new_line = true
ij_php_catch_on_new_line = true
ij_php_finally_on_new_line = true
ij_php_else_if_style = combine
ij_php_concat_spaces = false
ij_php_align_key_value_pairs = true
ij_php_align_class_constants = true
ij_php_align_enum_cases = true
ij_php_align_group_field_declarations = true
ij_php_align_inline_comments = true
ij_php_align_named_arguments = true
ij_php_align_multiline_array_initializer_expression = true
ij_php_align_phpdoc_comments = true
ij_php_align_phpdoc_param_names = true
ij_php_comma_after_last_array_element = true
ij_php_comma_after_last_parameter_style = always
ij_php_force_short_declaration_array_style = true
ij_php_force_empty_classes_in_one_line = true
ij_php_force_empty_methods_in_one_line = true
ij_php_keep_simple_classes_in_one_line = true
ij_php_keep_simple_methods_in_one_line = true
ij_php_keep_rparen_and_lbrace_on_one_line = true
ij_php_keep_first_column_comment = false
ij_php_lower_case_boolean_const = true
ij_php_lower_case_null_const = true
ij_php_new_line_after_php_opening_tag = true
ij_php_phpdoc_blank_line_before_tags = true
ij_php_phpdoc_blank_lines_around_parameters = true
ij_php_phpdoc_keep_blank_lines = false
ij_php_phpdoc_use_fqcn = true
ij_php_variable_naming_style = camel_case

[*.js]
ij_javascript_else_on_new_line = true
ij_javascript_catch_on_new_line = true
ij_javascript_finally_on_new_line = true
ij_javascript_use_double_quotes = false
ij_javascript_space_after_property_colon = false
ij_javascript_space_before_function_left_parenth = false
ij_javascript_space_before_async_arrow_lparen = false
ij_javascript_spaces_around_additive_operators = false
ij_javascript_spaces_around_multiplicative_operators = false

[*.css]
ij_css_brace_placement = end_of_line
ij_css_keep_single_line_blocks = false
ij_css_space_after_colon = true
ij_css_hex_color_lower_case = true

[*.{html,htm}]
ij_html_uniform_ident = true
ij_html_text_wrap = off
ij_html_space_inside_empty_tag = true

[*.md]
# two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
ij_markdown_format_tables = true
ij_markdown_wrap_text_if_long = false

# CLAUDE.md and .claude/ keep compact tables (CLAUDE.md, Coding Conventions)
[{CLAUDE.md,**/CLAUDE.md,.claude/**.md,**/.claude/**.md}]
ij_markdown_format_tables = false

# installed packages are third party code: the IDE leaves their file end and trailing spaces as shipped
[{vendor/**,**/vendor/**,node_modules/**,**/node_modules/**}]
insert_final_newline = false
trim_trailing_whitespace = false
